# Copy to .env at repo root and fill real values (never commit .env).
# Teacher access JWT (15m). Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_me
# Admin access JWT (5m, separate secret, refresh 1 day). Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ADMIN_SECRET=change_me_too
MONGO_URI=
# 32-byte hex key for src/utils/crypto.util.js. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=
PORT=3000
# Frontend URL for CORS tightening (production). Leave empty for same-origin dev.
FRONTEND_URL=
# Trust proxy hops (rate limiter + secure cookies behind nginx). Default 1.
TRUST_PROXY=1
# Committee day boundaries. IANA zone, e.g. Asia/Dhaka. Default UTC.
APP_TIMEZONE=UTC
# Refresh cookies: Strict (default) | Lax | None.
# Same registrable domain required for Strict/Lax (set COOKIE_DOMAIN=.example.com).
# Cross-site API+frontend must use None (forces Secure) plus CSRF protection.
COOKIE_SAMESITE=Strict
COOKIE_DOMAIN=
# Seed: node scripts/seed-admin.js <username> <password> (run from server/)
# Seed: node scripts/seed-chairman.js "<name>" <email> <tempPassword> [phone]
